{
  "name": "@mirrorai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build -w @mirrorai/shared && npm run build -w @mirrorai/knowledge && npm run build -w @mirrorai/risk-engine && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build:mobile": "VITE_ANALYSIS_MODE=local npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@mirrorai/knowledge": "0.1.0",
    "@mirrorai/risk-engine": "0.1.0",
    "@mirrorai/shared": "0.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.6"
  }
}
